@page "/cart"
@rendermode InteractiveServer
@inject ShoppingCartApiClient CartApiClient

<PageTitle>Shopping Cart</PageTitle>

<h1>Shopping Cart</h1>

@if (_isLoading)
{
    <p>Loading your cart...</p>
}
else if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}
else if (_cart is null || _cart.Items.Count == 0)
{
    <p>Your cart is empty. <a href="">Browse products</a> to add an item.</p>
}
else
{
    @if (_successMessage is not null)
    {
        <div class="alert alert-success" role="alert">@_successMessage</div>
    }

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Product</th>
                    <th class="text-end">Unit price</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Line total</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in _cart.Items)
                {
                    <tr>
                        <td>@item.ProductName</td>
                        <td class="text-end">@item.UnitPrice.ToString("C")</td>
                        <td class="text-end">@item.Quantity</td>
                        <td class="text-end">@item.LineTotal.ToString("C")</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveItemAsync(item.ProductId)">
                                Remove
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="3" class="text-end">Total</th>
                    <th class="text-end">@_cart.TotalAmount.ToString("C")</th>
                    <th></th>
                </tr>
            </tfoot>
        </table>
    </div>

    <form class="row g-3" @onsubmit="CheckoutAsync" @onsubmit:preventDefault="true">
        <div class="col-md-6">
            <label class="form-label" for="customer-name">Customer name</label>
            <input id="customer-name" class="form-control" @bind="_customerName" required />
        </div>
        <div class="col-12">
            <button class="btn btn-success" type="submit">Checkout</button>
        </div>
    </form>
}

@code {
    private ShoppingCartResponse? _cart;
    private string _customerName = string.Empty;
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        await LoadCartAsync();
    }

    private async Task LoadCartAsync()
    {
        try
        {
            _cart = await CartApiClient.GetCartAsync();
            _errorMessage = null;
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RemoveItemAsync(int productId)
    {
        try
        {
            await CartApiClient.RemoveItemAsync(productId);
            await LoadCartAsync();
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = exception.Message;
        }
    }

    private async Task CheckoutAsync()
    {
        try
        {
            var order = await CartApiClient.CheckoutAsync(_customerName);
            _successMessage = $"Order #{order.Id} was created successfully.";
            _customerName = string.Empty;
            await LoadCartAsync();
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = exception.Message;
            _successMessage = null;
        }
    }
}
