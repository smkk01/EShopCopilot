@page "/product"
@rendermode InteractiveServer
@inject ShoppingCartApiClient CartApiClient

<PageTitle>Products</PageTitle>

<h1>Products</h1>

@if (_isLoading)
{
    <p>Loading products...</p>
}
else if (_errorMessage is not null)
{
    <div class="alert alert-danger" role="alert">@_errorMessage</div>
}
else
{
    @if (_successMessage is not null)
    {
        <div class="alert alert-success" role="alert">@_successMessage</div>
    }

    <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
        @foreach (var product in _products)
        {
            <div class="col">
                <div class="card h-100">
                    <img class="card-img-top" src="@product.ImageUrl" alt="@product.Name" />
                    <div class="card-body d-flex flex-column">
                        <h2 class="h5 card-title">@product.Name</h2>
                        <p class="card-text">@product.Description</p>
                        <p class="fw-bold mt-auto">@product.Price.ToString("C")</p>
                        <button class="btn btn-primary" @onclick="() => AddToCartAsync(product.Id)">
                            Add to cart
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private IReadOnlyList<ProductResponse> _products = [];
    private string? _errorMessage;
    private string? _successMessage;
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _products = await CartApiClient.GetProductsAsync();
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = exception.Message;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AddToCartAsync(int productId)
    {
        try
        {
            await CartApiClient.AddItemAsync(productId);
            _successMessage = "Product added to your cart.";
            _errorMessage = null;
        }
        catch (HttpRequestException exception)
        {
            _errorMessage = exception.Message;
            _successMessage = null;
        }
    }
}
